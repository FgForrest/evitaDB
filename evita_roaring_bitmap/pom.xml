<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>evita_roaring_bitmap</artifactId>
	<packaging>jar</packaging>
	<name>evitaDB - Vendored RoaringBitmap (persistent/structure-sharing)</name>
	<description>Vendored subset of RoaringBitmap (Apache-2.0) reshaped into a single persistent bitmap per data type
		(PersistentRoaringBitmap / PersistentLongRoaringBitmap). See NOTICE for attribution and synced upstream commit.</description>
	<parent>
		<groupId>io.evitadb</groupId>
		<artifactId>evita_root</artifactId>
		<version>2026.3-SNAPSHOT</version>
	</parent>
	<dependencies>
		<!--
			Test-scope dependencies required by the vendored upstream test suite.
			Versions are managed by the root POM's dependencyManagement.
			These never leak into the produced jar (test scope only); JUnit is inherited
			from the root POM's shared <dependencies> block.
		-->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!--
						`io.evitadb.roaringbitmap.kernel.VectorBitmapKernels` compiles against the incubating
						Vector API, which is never in the default root set and therefore has to be added
						explicitly; javac answers with one "using incubating module(s)" warning per compiled
						module. The argument is scoped to this module rather than inherited from the root POM
						because the modules reachable from the Java driver compile at a lower API level and must
						not see it. `-parameters` is repeated because a child `compilerArgs` list replaces the
						parent's rather than extending it. At run time the module stays optional (`requires
						static` in the module descriptor), so a JVM started without the matching launcher
						argument simply runs the scalar kernels.
					-->
					<compilerArgs>
						<arg>-parameters</arg>
						<arg>--add-modules</arg>
						<arg>jdk.incubator.vector</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						See root pom.xml's `roaringBitmap.skipTests` property doc - CI overrides this
						to skip this module's tests on pushes/PRs that don't touch evita_roaring_bitmap.
					-->
					<skipTests>${roaringBitmap.skipTests}</skipTests>
				</configuration>
				<executions>
					<!--
						The container arithmetic runs on whichever kernel implementation
						`io.evitadb.roaringbitmap.kernel.VectorKernels` selects, so a green suite proves only the
						implementation that happened to be selected. Both are therefore exercised: the default
						execution runs whatever the JVM offers (the vector kernels, on a box whose JDK resolves
						`jdk.incubator.vector`, which the root surefire argLine adds), and this one forces the
						scalar fallback with the kill switch. The switch is passed as a system property rather
						than through `argLine`, because overriding `argLine` here would drop the whole set of
						module and package opening arguments the root POM assembles.
					-->
					<execution>
						<id>scalar-kernels</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<skipTests>${roaringBitmap.skipTests}</skipTests>
							<systemPropertyVariables>
								<evita.roaring.vector>false</evita.roaring.vector>
							</systemPropertyVariables>
							<reportsDirectory>${project.build.directory}/surefire-reports-scalar</reportsDirectory>
							<reportNameSuffix>scalar</reportNameSuffix>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
