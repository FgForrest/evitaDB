query(
  collection("Product"),
  filterBy(
    entityLocaleEquals("en"),
    hierarchyWithin(
      "categories",
      attributeEquals("url", "/en/smartwatches")
    ),
    userFilter(
      facetHaving(
        "brand",
        entityPrimaryKeyInSet(66465)
      )
    )
  ),
  require(
    referenceSummaryOfReference(
      "brand",
      IMPACT,
      orderBy(attributeNatural("name", ASC)),
      entityFetch(attributeContent("name"))
    )
  )
)
