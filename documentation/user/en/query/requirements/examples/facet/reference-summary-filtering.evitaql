query(
    collection("Product"),
    filterBy(
        attributeEquals("status", "ACTIVE")
    ),
    require(
        referenceSummary(
            COUNTS,
            filterBy(attributeContains("code", "ar")),
            filterGroupBy(attributeStartsWith("code", "o")),
            entityFetch(attributeContent("code")),
            entityGroupFetch(attributeContent("code"))
        )
    )
)