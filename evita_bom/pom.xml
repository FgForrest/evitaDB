<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>evita_bom</artifactId>
	<packaging>pom</packaging>
	<name>evitaDB - Bill of Materials</name>
	<description>Version alignment for published evitaDB libraries.</description>
	<parent>
		<groupId>io.evitadb</groupId>
		<artifactId>evita_root</artifactId>
		<version>2026.3-SNAPSHOT</version>
	</parent>

	<!--
		Lists exactly the evitaDB artifacts the release deploys. A newly published module belongs here; a module
		that is not deployed (tests, jacoco, the shaded driver recipe) must never appear, because its entry would
		resolve in our own builds and fail for every consumer.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_roaring_bitmap</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_query</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_engine</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_db</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_store_key_value</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_store_entity</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_store_server</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_traffic_engine</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_export_fs</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_export_s3</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_graphql</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_java_driver</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_java_driver_observability</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_grpc</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_grpc_shared</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_rest</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_system</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_lab</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_external_api_observability</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_server</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.evitadb</groupId>
				<artifactId>evita_test_support</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<!--
						Keep only this BOM's management entries, without the parent's third-party pins. The inherited
						dependencies and the build section (the staging extension) mean nothing to an importer.
					-->
					<flattenMode>bom</flattenMode>
					<updatePomFile>true</updatePomFile>
					<outputDirectory>${project.build.directory}</outputDirectory>
					<pomElements>
						<dependencies>remove</dependencies>
						<build>remove</build>
					</pomElements>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
