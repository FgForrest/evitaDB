			<artifactId>evita_server</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_java_driver</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_test_support</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.22.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-yaml</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.module</groupId>
			<artifactId>jackson-module-parameter-names</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-text</artifactId>
			<version>1.15.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.steppschuh.markdowngenerator</groupId>
			<artifactId>markdowngenerator</artifactId>
			<version>1.3.1.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.thoughtworks.qdox</groupId>
			<artifactId>qdox</artifactId>
			<version>2.2.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>one.edee.oss</groupId>
			<artifactId>proxycian_bytebuddy</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-sdk-testing</artifactId>
			<version>${opentelemetry.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.json-unit</groupId>
			<artifactId>json-unit</artifactId>
			<version>6.3.0</version>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.json-unit</groupId>
			<artifactId>json-unit-assertj</artifactId>
			<version>6.3.0</version>
		</dependency>
		<!--
			Ground truth for the heap-size estimates in `MemoryMeasuringConstants` / `EvitaDataTypes.estimateSize`.
			Test scope only - JOL is far too heavy to ship, but it is the only way to assert an estimate is actually
			RIGHT rather than merely unchanged. Version managed in the parent, shared with the memory spikes in
			evita_performance_tests.
		-->
		<dependency>
			<groupId>org.openjdk.jol</groupId>
			<artifactId>jol-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Writes the release upgrade fixtures - catalogs and storage parts written by the RELEASED engines, which
				the upgrade tests open with the current one - straight into the test output directory, under
				`testData`, where the generator replaces its own previous output as a whole. They are produced here
				instead of being committed, because binary fixtures do not belong in the repository. The generator is a
				Java program run in source-file mode, so the step needs only Maven and the JDK on any operating system.
				It downloads the release jars on first use, through a nested run of this build's Maven given its local
				repository, offline mode and settings files, and skips the run while its inputs and output are
				unchanged; see `tools/fixtures/GenerateReleaseFixtures.java`. Running such a test from IntelliJ, which
				builds with the `intellij-idea-only` profile, needs this phase to have run with that profile since
				IntelliJ last rebuilt the module:
				`mvn generate-test-resources -P intellij-idea-only -pl evita_test/evita_functional_tests`.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.4</version>
				<executions>
					<execution>
						<id>generate-release-fixtures</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>${releaseFixtures.skip}</skip>
							<executable>${releaseFixtures.java}</executable>
							<!-- each option embeds its expression in text, which makes the plugin receive a string -->
							<arguments>
								<argument>${releaseFixtures.tools}/GenerateReleaseFixtures.java</argument>
								<argument>--project-root=${project.basedir}/../..</argument>
								<argument>--work-dir=${project.build.directory}/release-fixtures</argument>
								<argument>--maven-home=${maven.home}</argument>
								<argument>--maven-repo-local=${settings.localRepository}</argument>
								<argument>--maven-offline=${settings.offline}</argument>
								<argument>--maven-settings=${session.request.userSettingsFile}</argument>
								<argument>--maven-global-settings=${session.request.globalSettingsFile}</argument>
								<argument>${project.build.testOutputDirectory}/testData</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				Publish a test-jar so other test modules (notably evita_long_running_tests)
				can reuse helper / fixture / mock classes that live in src/test/java here.
				The test-jar packages the whole test output directory, so it also bundles the
				test resources, the release upgrade fixtures under `testData` included.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!--
		Only this module's tests read the release upgrade fixtures, so a build that runs none of them does not write
		them: tests skipped by property, and the `documentation` / `longRunning` suites, which skip this module's tests.
	-->
	<profiles>
		<profile>
			<id>release-fixtures-without-tests</id>
			<activation>
				<property>
					<name>skipTests</name>
					<value>true</value>
				</property>
			</activation>
			<properties>
				<releaseFixtures.skip>true</releaseFixtures.skip>
			</properties>
		</profile>
		<profile>
			<id>release-fixtures-without-test-build</id>
			<activation>
				<property>
					<name>maven.test.skip</name>
					<value>true</value>
				</property>
			</activation>
			<properties>
				<releaseFixtures.skip>true</releaseFixtures.skip>
			</properties>
		</profile>
		<profile>
			<id>documentation</id>
			<properties>
				<releaseFixtures.skip>true</releaseFixtures.skip>
			</properties>
		</profile>
		<profile>
			<id>longRunning</id>
			<properties>
				<releaseFixtures.skip>true</releaseFixtures.skip>
			</properties>
		</profile>
		<profile>
			<id>release-fixtures-on-windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<releaseFixtures.java>${java.home}/bin/java.exe</releaseFixtures.java>
			</properties>
		</profile>
	</profiles>
</project>
