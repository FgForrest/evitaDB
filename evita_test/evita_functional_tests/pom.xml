<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>evita_functional_tests</artifactId>
	<packaging>jar</packaging>
	<name>evitaDB - Functional tests</name>
	<parent>
		<groupId>io.evitadb</groupId>
		<artifactId>evita_root</artifactId>
		<version>2026.3-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<properties>
		<sonar.skip>true</sonar.skip>
		<!--
			Test modules are not published to Maven Central. Skipping install/deploy
			here also avoids the test-jar resolution failure during the deploy step,
			which runs with `-Dmaven.test.skip=true` and therefore does not produce
			the `-tests` classifier consumed by `evita_long_running_tests`.
		-->
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
		<skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
		<!--
			`true` skips writing the release upgrade fixtures (the `generate-release-fixtures` execution below); the
			profiles at the end set it for every build that runs no tests of this module. Pass it by hand to build
			without the network before the local repository holds the two releases the fixtures are written with; the
			release upgrade tests then fail, each naming the fixture it misses.
		-->
		<releaseFixtures.skip>false</releaseFixtures.skip>
		<!-- the JDK that runs Maven runs the fixture generator; the Windows profile at the end names `java.exe` -->
		<releaseFixtures.java>${java.home}/bin/java</releaseFixtures.java>
		<releaseFixtures.tools>${project.basedir}/../../tools/fixtures</releaseFixtures.tools>
	</properties>

