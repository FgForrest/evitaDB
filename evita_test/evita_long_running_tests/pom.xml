<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>evita_long_running_tests</artifactId>
	<packaging>jar</packaging>
	<name>evitaDB - Long-running tests</name>
	<description>Module hosts the slow / generative test suite — randomized soak tests, multi-thread stress tests, large-dataset scenarios and any other test that takes minutes to run. Skipped by default; executed only when the `longRunning` profile is active or the module is targeted directly via `-pl`.</description>
	<parent>
		<groupId>io.evitadb</groupId>
		<artifactId>evita_root</artifactId>
		<version>2026.2-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<properties>
		<sonar.skip>true</sonar.skip>
		<!-- Test module: not published to Maven Central. -->
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
		<skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
		<!--
			Fork heap for the long-running test JVM. Override on the command line
			(e.g. `-DlongRunningArgLine=-Xmx55g`) for the large-dataset soak tests
			that need more than the default heap.
		-->
		<longRunningArgLine>-Xmx5g</longRunningArgLine>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>${assertj.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_common</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_api</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_engine</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_store_key_value</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_store_entity</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_store_server</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_external_api_grpc</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_external_api_graphql</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_external_api_rest</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_external_api_lab</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_external_api_observability</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_export_fs</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_export_s3</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_traffic_engine</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_server</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_java_driver</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_test_support</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!--
				Test-jar of evita_functional_tests provides shared fixture / helper /
				mock classes that the moved long-running tests rely on (e.g.
				`io.evitadb.api.GenerationalTestSupport`, `io.evitadb.api.proxy.mock`,
				`io.evitadb.api.functional.indexing.*`). The test-jar packaging is
				produced by maven-jar-plugin's `test-jar` goal in functional_tests.

				BUILD THIS MODULE TOGETHER WITH evita_functional_tests, never alone:

				    mvn -pl evita_test/evita_functional_tests,evita_test/evita_long_running_tests test

				functional_tests sets `maven.install.skip=true` (see its pom), so its
				test-jar is NEVER refreshed in the local repository. Building this module
				on its own therefore resolves whatever `-tests` jar happens to be sitting
				in ~/.m2 - possibly months old - and the failure surfaces as dozens of
				compile errors against helper signatures in `AssertionUtils`, pointing at
				test code here that is perfectly correct. `mvn install` on functional_tests
				does NOT fix it; only a shared reactor does, because that resolves the
				sibling's `target/` output instead.
			-->
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>evita_functional_tests</artifactId>
			<version>${project.parent.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>one.edee.oss</groupId>
			<artifactId>proxycian_bytebuddy</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-sdk-testing</artifactId>
			<version>${opentelemetry.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.json-unit</groupId>
			<artifactId>json-unit</artifactId>
			<version>6.0.1</version>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.json-unit</groupId>
			<artifactId>json-unit-assertj</artifactId>
			<version>6.0.1</version>
		</dependency>
		<!--
			Required to boot EvitaServer, which registers ParameterNamesModule on its YAML mapper. Declared in
			evita_functional_tests at test scope, and test-scope dependencies are not transitive, so depending on
			that module does not bring it along - without this every test here that starts a server dies in setUp
			with NoClassDefFoundError. Went unnoticed because the tests that need it are @Disabled by default.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.module</groupId>
			<artifactId>jackson-module-parameter-names</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-text</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						Long-running tests are slow / generative; skipped by default. The
						`longRunning` profile (in this pom and in the root pom) flips
						skipTests to `false` for this module while keeping it `true` for
						the rest of the reactor, so `-P longRunning` runs only long-running
						tests.
					-->
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>longRunning</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration combine.self="override">
							<skipTests>false</skipTests>
							<parallel>all</parallel>
							<!--
								Cap concurrency to 4 absolute execution threads (perCoreThreadCount=false
								means threadCount is taken verbatim, not multiplied by the CPU core count).
								The generational soak tests each build sizeable in-memory catalogs and are
								themselves internally multi-threaded, so an unbounded fan-out collectively
								exhausts the 5G fork heap; 4 keeps aggregate peak memory within that limit.
							-->
							<perCoreThreadCount>false</perCoreThreadCount>
							<threadCount>4</threadCount>
							<argLine>${longRunningArgLine} --add-opens java.base/java.lang.invoke=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
